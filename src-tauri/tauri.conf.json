{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Carta",
  "version": "0.1.0",
  "identifier": "com.emmgfx.carta",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Carta",
        "width": 640,
        "height": 432,
        "minWidth": 520,
        "minHeight": 380,
        "dragDropEnabled": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 20, "y": 28 }
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns"],
    "externalBin": ["binaries/ffmpeg", "binaries/ffprobe"],
    "resources": ["licenses/*"],
    "macOS": { "minimumSystemVersion": "10.15" }
  }
}
